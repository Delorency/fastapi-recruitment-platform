# PROJECT

PROJECT_NAME=recruitment-platform
PROJECT_PATH=/home/delorency/work/fastapi-recruitment-platform
STATICDIR=static/


# SERVER

HOST=0.0.0.0
PORT=8080

# DB

DB_TYPE=postgresql # postgresql | mysql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recplat
DB_USER=delorency
DB_PASS=delorency


# REDIS

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_USER=default
REDIS_PASS=default


# JWT

TYP=JWT
ALG=SHA512
ISS="Recruitment platform"
SECRET_KEY="not secret key"

ACCESS_TOKEN_EXPIRE=43200
REFRESH_TOKEN_EXPIRE=2592000


# LOGGERS

LOGSDIR=logs/ # папка с логами
APILOGFILENAME=api_fiolib.log # название файла с логами для api
DBLOGFILENAME=db_fiolib.log # название файла с логами обращений к бд